# Gmail account used to send team invitations (server only).
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional: public app URL included in invitation emails.
APP_URL=http://localhost:5173

# Gemini AI evaluation of Lost Connection reflections (server only; never frontend).
# Copy your Gemini API key from Google AI Studio into the private .env file.
# Without this key the reflection is saved, but progression waits until evaluation is available.
# GEMINI_API_KEY=
# GEMINI_REFLECTION_MODEL=gemini-3.8-flash
